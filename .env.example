# Copier ce fichier en .env (jamais commité) puis adapter. docker compose le lit automatiquement.

# Clé qui signe les jetons de connexion (JWT). Générer une vraie clé :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire

# Sites autorisés à appeler l'API depuis un navigateur (CORS)
ALLOWED_ORIGINS=http://localhost:8501
