# Copier ce fichier en .env (jamais commité) puis adapter. docker compose le lit automatiquement.

# Clé qui signe les jetons de connexion (JWT). Générer une vraie clé :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire

# Sites autorisés à appeler l'API depuis un navigateur (CORS), séparés par des virgules, jamais "*"
# 8501 = tableau de bord Streamlit, 5173 = front-end React (npm run dev dans frontend/)
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:5173
